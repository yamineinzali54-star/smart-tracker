# Copy this file to .env.local and fill in values from Supabase Project Settings > API.
# Use the project URL and publishable/anon key only in the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Keep AI provider keys server-side only; never use a VITE_ prefix for secrets.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
