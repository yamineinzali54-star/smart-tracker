# Frontend Environment Variables
# These are safe to expose to the browser (anon keys)

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# Backend Environment Variables (in backend/.env)
# These should NOT be exposed to the browser

# Server-side LLM API key (OpenRouter / Gemini)
LLM_API_KEY=sk-or-v1-your_key_here

# Supabase project URL (for backend JWT verification)
SUPABASE_URL=your_supabase_project_url

# Supabase service role key (for backend DB operations - KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key